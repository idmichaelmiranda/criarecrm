# Copie para .env e preencha os valores reais (nunca commitar o .env com dados reais)

# Banco de dados
DATABASE_URL=postgresql://postgres:SENHA@db.xxxxxxxx.supabase.co:5432/postgres

# URL pública do próprio backend (usada para montar links de upload/avatar)
BACKEND_URL=https://SEU-BACKEND.onrender.com

# URL pública do frontend (usada para configurar CORS)
FRONTEND_URL=https://SEU-APP.vercel.app

# Chave secreta JWT — gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
