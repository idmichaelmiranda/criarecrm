# Preenchido automaticamente pelo Vercel via Environment Variables
# Não commitar valores reais aqui — configurar direto no painel do Vercel
VITE_API_URL=https://SEU-BACKEND.onrender.com/api/v1

# Chave gratuita da CARTO para os tiles do mapa (Resultados > Mapa). Pedir em
# https://carto.com/basemaps/apikey/ (sem cartão, sem aprovação, chave por email).
# Sem essa variável definida, o mapa volta a mostrar "API KEY REQUIRED".
VITE_CARTO_API_KEY=
